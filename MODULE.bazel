module(name = "raylib", version = "6.0.0")

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "toolchains_llvm", version = "1.9.1")
bazel_dep(name = "apple_support", version = "2.8.3")

# Hermetic clang for the remote linux/amd64 workers. Without a registered cc
# toolchain that is *exec*-compatible with linux x86_64, cc_* targets fail
# analysis under --config=remote with "No matching toolchains found for
# @bazel_tools//tools/cpp:toolchain_type".
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "17.0.6",
    # Only claim linux x86_64; local macOS builds keep using Xcode's clang.
    exec_os = "linux",
    exec_arch = "amd64",
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")
