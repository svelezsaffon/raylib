    ] + glob(["src/external/*.h"]),
    textual_hdrs = glob([
        "src/external/*.c",
        "src/platforms/*.c",
    ]),
    copts = [
        "-fno-strict-aliasing",
        "-Werror=implicit-function-declaration",
        "-Werror=pointer-arith",
        "-std=gnu99",
    ],
    defines = [
        "GL_SILENCE_DEPRECATION",
