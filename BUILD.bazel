    ],
    includes = ["src"],
    linkopts = [
        "-framework Cocoa",
        "-framework IOKit",
        "-framework OpenGL",
        "-framework QuartzCore",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:public"],
    deps = [":glfw"],
)

